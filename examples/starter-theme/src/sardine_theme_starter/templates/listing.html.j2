{% extends "base.html.j2" %}
{% block main %}
<h1>{{ listing.title }}</h1>
{# `listing.search_index_url` is offered here too: a theme that wants
   client-side filtering mounts its own island. This one stays free of
   JavaScript, so it ignores it. #}
<ul>
  {% for entry in listing.entries %}
  <li>
    <a href="{{ entry.url }}">{{ entry.title }}</a>
    {% if entry.summary %}<p>{{ entry.summary }}</p>{% endif %}
    <time datetime="{{ entry.date_iso }}">{{ entry.date_human }}</time>
  </li>
  {% endfor %}
</ul>
{# Pagination is computed for you: which page you are on, and where the
   neighbours live — a theme never counts entries itself. #}
{% if listing.pages > 1 %}
<nav aria-label="Pagination">
  {% if listing.previous_url %}<a href="{{ listing.previous_url }}" rel="prev">&larr;</a>{% endif %}
  <span>{{ listing.page }} / {{ listing.pages }}</span>
  {% if listing.next_url %}<a href="{{ listing.next_url }}" rel="next">&rarr;</a>{% endif %}
</nav>
{% endif %}
{% endblock %}
