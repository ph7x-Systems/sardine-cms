{# The design-system component vocabulary (ADR-0055), born on the
   golden screen. Screens compose these instead of open-coding the
   patterns; a covered pattern outside the vocabulary is itself a
   non-conformance (DESIGN_RULES). #}

{% macro page_header(title, action_label=None, action_href=None) %}
{# DS-1/DS-3: one h1 carrying only the title; the screen's single
   primary action beside it. #}
<div class="d-flex justify-content-between align-items-center">
  <h1 class="h3 mb-0">{{ title }}</h1>
  {% if action_label %}<a class="btn btn-primary" href="{{ action_href }}">{{ action_label }}</a>{% endif %}
</div>
{% endmacro %}

{% macro empty_state(heading, body, action_label=None, action_href=None) %}
{# DS-7: what the emptiness means, then the next action. #}
<div class="card admin-empty-state">
  <div class="card-body text-center py-5">
    <h2 class="h5">{{ heading }}</h2>
    {% if body %}<p class="text-body-secondary mb-3 mx-auto admin-empty-state-body">{{ body }}</p>{% endif %}
    {% if action_label %}<a class="btn btn-primary" href="{{ action_href }}">{{ action_label }}</a>{% endif %}
  </div>
</div>
{% endmacro %}

{% macro filter_bar(action) %}
{# DS-4/DS-5: one toolbar per list — scoped search and filters in a
   single GET form; the caller provides the fields. #}
<form method="get" action="{{ action }}" class="card mb-3 admin-filter-bar">
  <div class="card-body d-flex flex-wrap gap-2 align-items-end py-2">
    {{ caller() }}
    <button type="submit" class="btn btn-outline-secondary btn-sm">{{ _("Filter") }}</button>
  </div>
</form>
{% endmacro %}

{% macro summary_line(listing) %}
{# The DataTable contract (#250): the count is stated before the rows. #}
<p class="form-text mb-2 admin-summary-line">{{ _("Showing %(first)s–%(last)s of %(total)s") | format(first=listing.first, last=listing.last, total=listing.total) }}</p>
{% endmacro %}

{% macro pagination(listing, base_url, params) %}
{# DS-19: one page at a time. ``params`` carries the active filters so
   paging never drops them. #}
{% if listing.pages > 1 %}
{% set query = params | dictsort | map("join", "=") | join("&") %}
<nav aria-label="{{ _("Pagination") }}">
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item{% if listing.page <= 1 %} disabled{% endif %}">
      <a class="page-link" href="{{ base_url }}?page={{ listing.page - 1 }}{% if query %}&{{ query }}{% endif %}">{{ _("Previous") }}</a>
    </li>
    <li class="page-item disabled"><span class="page-link">{{ listing.page }} / {{ listing.pages }}</span></li>
    <li class="page-item{% if listing.page >= listing.pages %} disabled{% endif %}">
      <a class="page-link" href="{{ base_url }}?page={{ listing.page + 1 }}{% if query %}&{{ query }}{% endif %}">{{ _("Next") }}</a>
    </li>
  </ul>
</nav>
{% endif %}
{% endmacro %}

{% macro disclosure(summary, open=false) %}
{# DS-17: sections beyond the basics ship closed; native details, no
   JavaScript. #}
<details class="mb-2 admin-disclosure"{% if open %} open{% endif %}>
  <summary class="form-text">{{ summary }}</summary>
  <div class="mt-2 ps-2 admin-disclosure-body">{{ caller() }}</div>
</details>
{% endmacro %}
