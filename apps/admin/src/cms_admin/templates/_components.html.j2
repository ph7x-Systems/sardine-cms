{# The design-system component vocabulary (ADR-0055), born on the
   golden screen. Screens compose these instead of open-coding the
   patterns; a covered pattern outside the vocabulary is itself a
   non-conformance (DESIGN_RULES). #}

{% macro page_header(title, action_label=None, action_href=None) %}
{# DS-1/DS-3: one h1 carrying only the title; the screen's single
   primary action beside it. #}
<div class="d-flex justify-content-between align-items-center">
  <h1 class="h3 mb-0">{{ title }}</h1>
  {% if action_label %}<a class="btn btn-primary" href="{{ action_href }}">{{ action_label }}</a>{% endif %}
</div>
{% endmacro %}

{% macro empty_state(heading, body, action_label=None, action_href=None) %}
{# DS-7: what the emptiness means, then the next action. #}
<div class="card admin-empty-state">
  <div class="card-body text-center py-5">
    <h2 class="h5">{{ heading }}</h2>
    {% if body %}<p class="text-body-secondary mb-3 mx-auto admin-empty-state-body">{{ body }}</p>{% endif %}
    {% if action_label %}<a class="btn btn-primary" href="{{ action_href }}">{{ action_label }}</a>{% endif %}
  </div>
</div>
{% endmacro %}

{% macro editor_header(back_href, back_label, title, badge=None) %}
{# DS-1/DS-10: back link, then one h1 carrying only the identity — the
   status renders BESIDE it, never inside it. #}
<nav aria-label="Breadcrumb" class="admin-breadcrumb"><a href="{{ back_href }}">&larr; {{ back_label }}</a></nav>
<div class="d-flex align-items-center gap-2 flex-wrap">
  <h1 class="h3 mb-0">{{ title }}</h1>
  {% if badge %}{{ badge }}{% endif %}
</div>
{% endmacro %}

{% macro action_bar(label) %}
{# DS-10: the editor's operations in one region under the header. #}
<div class="d-flex flex-wrap gap-2 mb-3 admin-action-bar" role="group" aria-label="{{ label }}">
  {{ caller() }}
</div>
{% endmacro %}

{% macro editor_nav(items) %}
{# DS-10: long editors expose internal navigation — plain anchors. #}
<nav aria-label="{{ _("On this page") }}" class="mb-3 admin-editor-nav">
  <ul class="nav nav-pills flex-wrap gap-1 small">
    {% for anchor, label in items %}
    <li class="nav-item"><a class="nav-link py-1 px-2 link-body-emphasis text-decoration-underline" href="#{{ anchor }}">{{ label }}</a></li>
    {% endfor %}
  </ul>
</nav>
{% endmacro %}

{% macro quiet_panel(title, summary, collapsed=true, section_id=None) %}
{# DS-18: an editor's auxiliary panels are not the task, so they arrive
   collapsed and the work area keeps the room.

   This is AdminLTE's own collapsible card — `card-tools` with a
   `btn-tool` bound to `data-lte-toggle="card-collapse"`, whose script is
   already vendored — not a hand-rolled disclosure. The theme ships the
   pattern; using it keeps one behaviour, one appearance, one set of
   keyboard semantics. #}
<div class="card mb-3{% if collapsed %} collapsed-card{% endif %}"{% if section_id %} id="{{ section_id }}"{% endif %}>
  <div class="card-header d-flex justify-content-between align-items-center gap-2">
    <h2 class="card-title h6 mb-0">{{ title }}</h2>
    <div class="d-flex align-items-center gap-2">
      {% if summary %}<span class="form-text mb-0">{{ summary }}</span>{% endif %}
      <div class="card-tools">
        <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse"
                aria-label="{{ title }}">
          <i class="bi {{ 'bi-plus-lg' if collapsed else 'bi-dash-lg' }}" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
  <div class="card-body">{{ caller() }}</div>
</div>
{% endmacro %}

{% macro form_section(title, section_id=None) %}
{# DS-9: one card per form area — the header names it, the caller
   fills it. #}
<div class="card mb-3"{% if section_id %} id="{{ section_id }}"{% endif %}>
  <div class="card-header"><h2 class="card-title h6 mb-0">{{ title }}</h2></div>
  <div class="card-body">{{ caller() }}</div>
</div>
{% endmacro %}

{% macro danger_zone() %}
{# DS-9/DS-11: destructive actions, visually separated, always last. #}
<div class="card border-danger mb-3" id="danger">
  <div class="card-header"><h2 class="card-title h6 mb-0 text-danger-emphasis">{{ _("Danger zone") }}</h2></div>
  <div class="card-body d-flex flex-wrap gap-2 align-items-center">{{ caller() }}</div>
</div>
{% endmacro %}

{% macro filter_bar(action) %}
{# DS-4/DS-5: one toolbar per list — scoped search and filters in a
   single GET form; the caller provides the fields. #}
<form method="get" action="{{ action }}" class="card mb-3 admin-filter-bar">
  <div class="card-body d-flex flex-wrap gap-2 align-items-end py-2">
    {{ caller() }}
    <button type="submit" class="btn btn-outline-secondary btn-sm">{{ _("Filter") }}</button>
  </div>
</form>
{% endmacro %}

{% macro summary_line(listing) %}
{# The DataTable contract (#250): the count is stated before the rows. #}
<p class="form-text mb-2 admin-summary-line">{{ _("Showing %(first)s–%(last)s of %(total)s") | format(first=listing.first, last=listing.last, total=listing.total) }}</p>
{% endmacro %}

{% macro pagination(listing, base_url, params) %}
{# DS-19: one page at a time. ``params`` carries the active filters so
   paging never drops them. #}
{% if listing.pages > 1 %}
{% set query = params | dictsort | map("join", "=") | join("&") %}
<nav aria-label="{{ _("Pagination") }}">
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item{% if listing.page <= 1 %} disabled{% endif %}">
      <a class="page-link" href="{{ base_url }}?page={{ listing.page - 1 }}{% if query %}&{{ query }}{% endif %}">{{ _("Previous") }}</a>
    </li>
    <li class="page-item disabled"><span class="page-link">{{ listing.page }} / {{ listing.pages }}</span></li>
    <li class="page-item{% if listing.page >= listing.pages %} disabled{% endif %}">
      <a class="page-link" href="{{ base_url }}?page={{ listing.page + 1 }}{% if query %}&{{ query }}{% endif %}">{{ _("Next") }}</a>
    </li>
  </ul>
</nav>
{% endif %}
{% endmacro %}

{% macro disclosure(summary, open=false) %}
{# DS-17: sections beyond the basics ship closed; native details, no
   JavaScript. #}
<details class="mb-2 admin-disclosure"{% if open %} open{% endif %}>
  <summary class="form-text">{{ summary }}</summary>
  <div class="mt-2 ps-2 admin-disclosure-body">{{ caller() }}</div>
</details>
{% endmacro %}
