{% extends "shell.html.j2" %}
{% block title %}{{ _("Dashboard") }} — Sardine CMS admin{% endblock %}
{% block header %}<h1 class="h3 mb-0">{{ _("Dashboard") }}</h1>{% endblock %}
{% block content %}
{% set has_attention = attention.in_review or attention.pending_translations or attention.upcoming or attention.stale_drafts %}
<div class="card mb-3">
  <div class="card-header"><h2 class="card-title h6 mb-0">{{ _("Needs attention") }}</h2></div>
  {% if has_attention %}
  <div class="card-body">
    <div class="row g-2">
      {% if attention.in_review %}
      <div class="col-12 col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none admin-block-card" href="/articles">
          <span class="card-body d-block">
            <span class="d-block fs-4 fw-semibold">{{ attention.in_review }}</span>
            <span class="d-block">{{ _("in review") }}</span>
            {% if attention.can_publish %}<span class="form-text">{{ _("waiting for your decision") }}</span>{% endif %}
          </span>
        </a>
      </div>
      {% endif %}
      {% if attention.pending_translations %}
      <div class="col-12 col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none admin-block-card" href="/translations">
          <span class="card-body d-block">
            <span class="d-block fs-4 fw-semibold">{{ attention.pending_translations }}</span>
            <span class="d-block">{{ _("translation pair(s) pending") }}</span>
          </span>
        </a>
      </div>
      {% endif %}
      {% if attention.upcoming %}
      <div class="col-12 col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none admin-block-card" href="/calendar">
          <span class="card-body d-block">
            <span class="d-block fs-4 fw-semibold">{{ attention.upcoming }}</span>
            <span class="d-block">{{ _("scheduled change(s) in the next 7 days") }}</span>
          </span>
        </a>
      </div>
      {% endif %}
      {% if attention.stale_drafts %}
      <div class="col-12 col-md-6 col-xl-3">
        <a class="card h-100 text-decoration-none admin-block-card" href="/pages">
          <span class="card-body d-block">
            <span class="d-block fs-4 fw-semibold">{{ attention.stale_drafts }}</span>
            <span class="d-block">{{ _("draft(s) untouched for 30 days") }}</span>
          </span>
        </a>
      </div>
      {% endif %}
    </div>
  </div>
  {% else %}
  <div class="card-body"><p class="admin-empty mb-0">{{ _("Nothing is waiting for you.") }}</p></div>
  {% endif %}
</div>
{% if totals.articles == 0 and totals.pages == 0 %}
<div class="card mb-3">
  <div class="card-header"><h2 class="card-title h6 mb-0">{{ _("First steps") }}</h2></div>
  <div class="card-body">
    <ol class="mb-0">
      <li><a href="/pages/new">{{ _("Create your first page") }}</a> — {{ _("pick blocks from the gallery and fill them in.") }}</li>
      <li>{{ _("Use the preview link on the page editor to see it with your theme.") }}</li>
      <li><a href="/publishing">{{ _("Publish") }}</a> — {{ _("the validation report tells you if anything is missing.") }}</li>
    </ol>
  </div>
</div>
{% endif %}
{% set tones = {"draft": "text-bg-secondary", "review": "text-bg-warning", "published": "text-bg-success", "archived": "text-bg-dark"} %}
{% set icons = {"draft": "bi-pencil", "review": "bi-hourglass-split", "published": "bi-check2-circle", "archived": "bi-archive"} %}
<section aria-labelledby="content-status">
  <h2 id="content-status" class="visually-hidden">{{ _("Content by status") }}</h2>
  <div class="row">
    {% for status in statuses %}
    <div class="col-6 col-lg-3">
      <div class="small-box {{ tones[status.value] }} admin-stat">
        <div class="inner">
          <h3>{{ counts[status] }}</h3>
          <p class="text-uppercase">{{ _(status.value) }}</p>
        </div>
        <i class="small-box-icon bi {{ icons[status.value] }}" aria-hidden="true"></i>
        {# The warning tone has dark text, so its footer link is dark too —
           same split the AdminLTE reference page makes. #}
        {# The count covers articles and pages alike — the label used to
           say "Articles" for both, so the dashboard read as if pages
           were not being reported at all. #}
        <span class="small-box-footer {{ 'link-dark' if status.value == 'review' else 'link-light' }} d-flex justify-content-center gap-2">
          <a class="{{ 'link-dark' if status.value == 'review' else 'link-light' }}" href="/articles?needs=">{{ _("Articles") }}</a>
          <span aria-hidden="true">·</span>
          <a class="{{ 'link-dark' if status.value == 'review' else 'link-light' }}" href="/pages">{{ _("Pages") }}</a>
        </span>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="row">
    {% for label, count, href, icon in (
        (_("Articles"), totals.articles, "/articles", "bi-file-text"),
        (_("Pages"), totals.pages, "/pages", "bi-layout-text-window"),
        (_("Media"), totals.media, "/media", "bi-image"),
    ) %}
    <div class="col-12 col-md-4">
      {# AdminLTE's info-box: the theme's own component for a labelled
         count, in place of three numbers inside a sentence. #}
      <a class="info-box text-decoration-none" href="{{ href }}">
        <span class="info-box-icon"><i class="bi {{ icon }}" aria-hidden="true"></i></span>
        <div class="info-box-content">
          <span class="info-box-text">{{ label }}</span>
          <span class="info-box-number">{{ count }}</span>
        </div>
      </a>
    </div>
    {% endfor %}
  </div>
</section>

<div class="row">
  <div class="col-lg-7">
    <div class="card mb-4">
      <div class="card-header"><h2 class="card-title h6 mb-0">{{ _("Translation coverage") }}</h2></div>
      {% if totals.articles + totals.pages > 0 %}
      <div class="card-body p-0 table-responsive admin-table-wrap">
        <table class="table table-striped mb-0 admin-table">
          <thead>
            <tr>
              <th scope="col">{{ _("Language") }}</th>
              {% for state in states %}<th scope="col" class="text-end">{{ _(state.value) }}</th>{% endfor %}
              <th scope="col">{{ _("Coverage") }}</th>
            </tr>
          </thead>
          <tbody>
            {% for language, cells in matrix.items() %}
            <tr>
              <th scope="row">{{ language.value | upper }}</th>
              {% for state in states %}<td class="text-end">{{ cells[state] }}</td>{% endfor %}
              <td>
                <span class="admin-coverage">
                  <progress max="100" value="{{ coverage[language] }}"
                            aria-label="{{ _('%(language)s coverage') | format(language=language.value | upper) }}"></progress>
                  {{ coverage[language] }}%
                </span>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="card-body"><p class="admin-empty mb-0">{{ _("No content yet — the coverage matrix appears once articles or pages exist.") }}</p></div>
      {% endif %}
    </div>
  </div>
  <div class="col-lg-5">
    {# The dashboard answers "is anything wrong?", not "list everything
       that is wrong": the gate verdict and the rules table are bounded,
       and the findings themselves live on the publishing screen, which
       has the filters and the pagination for them. Rendering 35 advisory
       rows here made the first screen anyone sees five thousand pixels
       of noise. #}
    {% set hide_issues = true %}
    {% include "_validation_report.html.j2" %}
    {% if report.issues %}
    <div class="card mb-4">
      <div class="card-header"><h2 class="card-title h6 mb-0">{{ _("Findings") }}</h2></div>
      <div class="card-body">
        <ul class="list-unstyled mb-2">
          {% for code, count in issue_counts %}
          <li class="d-flex justify-content-between gap-2">
            <span><code>{{ code }}</code></span>
            <span class="text-body-secondary">{{ count }}</span>
          </li>
          {% endfor %}
        </ul>
        <a href="/publishing#findings">{{ _("Review the findings") }}</a>
      </div>
    </div>
    {% endif %}
    <div class="card mb-4">
      <div class="card-header"><h2 class="card-title h6 mb-0">{{ _("Build and export") }}</h2></div>
      <div class="card-body">
        {% if last_build %}
        <dl class="mb-0 admin-source">
          <dt>{{ _("Last run") }}</dt>
          <dd>{{ last_build.kind }} · {{ last_build.when }}
            {% if last_build.ok %}<span class="badge text-bg-success admin-state admin-state-complete">{{ _("ok") }}</span>
            {% else %}<span class="badge text-bg-danger admin-state admin-state-missing">{{ _("failed") }}</span>{% endif %}</dd>
          {% if last_build.detail %}<dt>{{ _("Detail") }}</dt><dd class="mb-0">{{ last_build.detail }}</dd>{% endif %}
        </dl>
        {% else %}
        <p class="admin-empty mb-0">{{ _("No build or export has run from this panel yet.") }}
          {{ _("Use the") }} <a href="/publishing">{{ _("Publishing") }}</a> {{ _("panel, or the") }}
          <code>cms build</code> {{ _("and") }} <code>cms export</code> {{ _("commands.") }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
