{% extends "shell.html.j2" %}
{% from "_fields.html.j2" import preview_links_card, content_fields, metadata_fields, seo_fields, errors_block, state_badge, status_tag with context %}
{% from "_components.html.j2" import editor_header, action_bar, editor_nav, danger_zone, quiet_panel with context %}
{% block title %}{{ article.id }} — Sardine CMS admin{% endblock %}
{% block header %}{{ editor_header("/articles", _("Articles"), article.id, status_tag(article.status)) }}{% endblock %}
{% block content %}
{{ errors_block(errors) }}
{% call action_bar(_("Actions")) %}
  <form method="post" action="/articles/{{ article.id }}/duplicate" class="mb-0">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button type="submit" class="btn btn-outline-secondary btn-sm">{{ _("Duplicate as draft") }}</button>
  </form>
  {% if preview_path %}
  <a class="btn btn-outline-secondary btn-sm" href="{{ preview_path }}">{{ _("View in preview") }}</a>
  {% endif %}
  {% for t in transitions %}
  <form method="post" action="/articles/{{ article.id }}/status" class="mb-0">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="to" value="{{ t.to }}">
    <button type="submit" class="btn btn-sm {{ 'btn-success' if t.to == 'published' else 'btn-outline-secondary' }}">{{ _(t.label) }}</button>
  </form>
  {% endfor %}
{% endcall %}
<form id="picker-search" method="get"></form>
{{ editor_nav([
    ("content", _("Content")),
    ("translations", _("Translations")),
    ("notes", _("Editorial notes")),
    ("revisions", _("Revisions")),
    ("preview-links", _("External preview links")),
    ("danger", _("Danger zone")),
]) }}
<div class="row admin-sbs" id="content">
  <div class="col-lg-6">
    <form method="post" action="/articles/{{ article.id }}" class="admin-form"
          data-autosave data-autosave-url="/articles/{{ article.id }}/autosave">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="card mb-3">
        <div class="card-header"><h2 class="card-title h6 mb-0">{{ _("Source (EN)") }}</h2></div>
        <div class="card-body">{{ content_fields(form) }}</div>
      </div>
      <div class="card mb-3">
        <div class="card-header"><h2 class="card-title h6 mb-0">{{ _("Metadata") }}</h2></div>
        <div class="card-body">{{ metadata_fields(form) }}{{ seo_fields(form) }}</div>
      </div>
      {% set custom_used = custom_rows | selectattr("name") | list | length %}
      {% call quiet_panel(_("Custom fields"),
          _("%(count)s set") | format(count=custom_used) if custom_used else _("none"),
          collapsed=not custom_used) %}
          <p class="form-text">{{ _("Free-form name/value pairs carried to themes and extensions (ADR-0028); clear a value to drop its field.") }}</p>
          <div class="table-responsive admin-table-wrap">
            <table class="table table-sm mb-0 admin-table">
              <thead><tr><th scope="col">{{ _("Field") }}</th><th scope="col">{{ _("Value") }}</th></tr></thead>
              <tbody>
                {% for row in custom_rows %}
                <tr>
                  <td><label class="mb-0 w-100">
                    <span class="visually-hidden">{{ _("Field name") }}</span>
                    <input class="form-control form-control-sm admin-input" name="custom_name" value="{{ row.name }}"></label></td>
                  <td><label class="mb-0 w-100">
                    <span class="visually-hidden">{{ _("Field value") }}</span>
                    <input class="form-control form-control-sm admin-input admin-field-value" name="custom_value"
                           value="{{ row.value }}"></label></td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
      {% endcall %}
      <p class="form-text" role="status" aria-live="polite" data-autosave-status
         data-saving="{{ _('Saving…') }}" data-saved="{{ _('Saved') }}"
         data-invalid="{{ _('Autosave paused — fix invalid fields.') }}"></p>
      <button type="submit" class="btn btn-primary mb-3">{{ _("Save") }}</button>
    </form>
  </div>
  <div class="col-lg-6">
    {# The preview follows the form instead of scrolling away after the
       first card. It scrolls internally when the rendered entry is long,
       so it is focusable and named — a scrollable region has to be
       reachable from the keyboard. #}
    <div class="card mb-3 admin-sticky-panel" tabindex="0" role="region"
         aria-label="{{ _("Preview") }}" id="design">
      {# Two read-only renders of the same entry, so they share one card
         through the theme's own header tabs instead of sitting eight
         hundred pixels apart. Both are conveniences: no form field is
         hidden behind a tab, because the panel is operable without
         JavaScript. #}
      <div class="card-header p-0 border-bottom-0">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-markdown" data-bs-toggle="tab"
                    data-bs-target="#pane-markdown" type="button" role="tab"
                    aria-controls="pane-markdown" aria-selected="true">{{ _("Preview") }}</button>
          </li>
          {% if preview_path %}
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-design" data-bs-toggle="tab"
                    data-bs-target="#pane-design" type="button" role="tab"
                    aria-controls="pane-design" aria-selected="false">{{ _("Design preview") }}</button>
          </li>
          {% endif %}
        </ul>
      </div>
      <div class="card-body tab-content">
        <div class="tab-pane fade show active" id="pane-markdown" role="tabpanel"
             aria-labelledby="tab-markdown">
          <p class="form-text">{{ _("Rendered with the builder's Markdown renderer (raw HTML disabled); shows the last saved body.") }}</p>
          <div class="admin-preview">{{ preview_html | safe }}</div>
        </div>
        {% if preview_path %}
        <div class="tab-pane fade p-0" id="pane-design" role="tabpanel" aria-labelledby="tab-design">
          {% include "_design_preview_body.html.j2" %}
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<div class="card" id="translations">
  <div class="card-header"><h2 class="card-title h6 mb-0">{{ _("Translations") }}</h2></div>
  <div class="card-body p-0 table-responsive admin-table-wrap">
    <table class="table table-striped mb-0 admin-table">
      <thead>
        <tr><th scope="col">{{ _("Language") }}</th><th scope="col">{{ _("State") }}</th><th scope="col">{{ _("Title") }}</th><th scope="col"></th></tr>
      </thead>
      <tbody>
        {% for language in target_languages %}
        {% set translation = article.translations.get(language) %}
        <tr>
          <th scope="row">{{ language.value | upper }}</th>
          <td>{{ state_badge(states[language]) }}</td>
          <td>{{ translation.content.title if translation else "" }}</td>
          <td><a href="/articles/{{ article.id }}/translations/{{ language.value }}">{{ _("Edit translation") }}</a></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
<div id="notes">{% include "_notes.html.j2" %}</div>
{% set base_url = "/articles/" ~ article.id %}
<div id="revisions">{% include "_revisions.html.j2" %}</div>
<div id="preview-links">{{ preview_links_card(preview_kind, preview_entry_id, preview_links, csrf_token) }}</div>
{% call danger_zone() %}
  <form method="post" action="/trash/article/{{ article.id }}" class="mb-0">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button type="submit" class="btn btn-outline-danger btn-sm">{{ _("Move to trash") }}</button>
  </form>
  <span class="form-text">{{ _("Trash keeps the entry restorable; nothing publishes from the trash.") }}</span>
{% endcall %}
{% endblock %}
