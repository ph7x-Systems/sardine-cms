{% extends "shell.html.j2" %}
{% from "_fields.html.j2" import translation_badges, status_tag, row_actions with context %}
{% from "_components.html.j2" import page_header, empty_state, filter_bar, summary_line, pagination with context %}
{% block title %}{{ _("Pages") }} — Sardine CMS admin{% endblock %}
{% block header %}{{ page_header(_("Pages"), _("New page"), "/pages/new") }}{% endblock %}
{% block content %}
{% call filter_bar("/pages") %}
  <div class="admin-field">
    <label class="form-label mb-1" for="pages-q">{{ _("Search") }}</label>
    <input class="form-control form-control-sm admin-input" id="pages-q" type="search"
           name="q" value="{{ q }}" placeholder="{{ _("Search items") }}">
  </div>
  {% if target_languages %}
  <div class="admin-field">
    <label class="form-label mb-1" for="pages-needs">{{ _("Needs translation into") }}</label>
    <select class="form-select form-select-sm admin-input" id="pages-needs" name="needs">
      <option value="">{{ _("Every entry") }}</option>
      {% for target in target_languages %}
      <option value="{{ target }}" {% if needs == target | string %}selected{% endif %}>
        {{ _("missing %(tag)s") | format(tag=target | upper) }}</option>
      {% endfor %}
    </select>
  </div>
  {% endif %}
{% endcall %}
{% if pages %}
<form method="post" action="/pages/bulk" id="bulk-form" class="card mb-3">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div class="card-body d-flex flex-wrap gap-2 align-items-center py-2">
    <label class="mb-0">
      <span class="visually-hidden admin-visually-hidden">{{ _("Bulk action") }}</span>
      <select class="form-select form-select-sm admin-input" name="action">
        <option value="to-review">{{ _("Submit for review") }}</option>
        <option value="to-draft">{{ _("Send back to draft") }}</option>
        <option value="publish">{{ _("Publish") }}</option>
        <option value="archive">{{ _("Archive") }}</option>
        <option value="trash">{{ _("Move to trash") }}</option>
      </select>
    </label>
    <button type="submit" class="btn btn-outline-primary btn-sm">{{ _("Apply to selected") }}</button>
    <span class="form-text mb-0">{{ _("Each entry keeps its own rules — the report shows every outcome.") }}</span>
  </div>
</form>
{{ summary_line(listing) }}
<div class="card">
  <div class="card-body p-0 table-responsive admin-table-wrap">
    <table class="table table-striped table-hover mb-0 admin-table">
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">{{ _("Select") }}</span></th>
          <th scope="col">{{ _("Title (EN)") }}</th>
          <th scope="col">{{ _("Status") }}</th>
          <th scope="col">{{ _("Sections") }}</th>
          <th scope="col">{{ _("Translations") }}</th>
          <th scope="col">{{ _("Updated") }}</th>
          <th scope="col"><span class="visually-hidden">{{ _("Actions") }}</span></th>
        </tr>
      </thead>
      <tbody>
        {% for page in pages %}
        <tr>
          <td><label class="mb-0"><span class="visually-hidden admin-visually-hidden">{{ _("Select %(id)s") | format(id=page.id) }}</span>
            <input class="form-check-input" type="checkbox" name="selected" value="{{ page.id }}" form="bulk-form"></label></td>
          <th scope="row">
            <a href="/pages/{{ page.id }}">{{ page.source.title or page.id }}</a>
            <span class="d-block form-text mb-0"><code>{{ page.id }}</code></span>
          </th>
          <td>{{ status_tag(page.status) }}</td>
          <td class="text-end">{{ page.sections | length }}</td>
          <td>{{ translation_badges(page, target_languages) }}</td>
          <td>{{ when(page.updated_at.date()) }}</td>
          <td>{{ row_actions("page", page.id, row_actions_map[page.id]) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="card-footer form-text">{{ _("Language states aggregate the page and all its sections — the least-complete state wins.") }}</div>
  {% if listing.pages > 1 %}
  <div class="card-footer">{{ pagination(listing, "/pages", {"needs": needs, "q": q}) }}</div>
  {% endif %}
</div>
{% elif q or needs %}
<p class="admin-empty">{{ _("Nothing matches the filter.") }}</p>
{% else %}
{{ empty_state(_("No pages yet — create the first one."), "", _("New page"), "/pages/new") }}
{% endif %}
{% endblock %}
